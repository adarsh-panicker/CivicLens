# Optional: Provide either GEMINI_API_KEY or OPENAI_API_KEY for live LLM extraction, Q&A, and letter generation.
# Without a key, CivicLens uses its built-in deterministic parser & template engine so the demo works out of the box.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
